rules_version = '2';

// TND Guides – Firestore security rules
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
// ADMINS: put your admin Gmail(s) in the list in isAdmin() below, in small letters,
// each in 'single quotes', separated by commas. This list is the ONLY place admins are set,
// and it stays private inside Firebase. Do not commit your real emails to GitHub.
//
// Anything not listed below is blocked for everyone.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------
    function signedIn() { return request.auth != null; }
    // Logged in AND email confirmed (Google accounts are confirmed automatically)
    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function isAdmin() {
      return verified()
        && request.auth.token.email.lower() in ['admin@example.com'];
    }
    function isOwner() { return signedIn() && resource.data.uid == request.auth.uid; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Student has paid and their time has not ended
    function hasAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.untilMs > request.time.toMillis();
    }

    // ---------- Checks on what is being saved ----------
    function newData() { return request.resource.data; }
    // Only these fields, and all of them
    function exactly(fields) { return newData().keys().hasOnly(fields) && newData().keys().hasAll(fields); }
    function textOk(field, max) { return newData()[field] is string && newData()[field].size() <= max; }
    function textReq(field, max) { return textOk(field, max) && newData()[field].size() > 0; }
    function listOk(field, max) { return newData()[field] is list && newData()[field].size() <= max; }
    function intOk(field, lo, hi) { return newData()[field] is int && newData()[field] >= lo && newData()[field] <= hi; }
    // A web link must start with https:// (or be empty)
    function linkOk(field) { return newData()[field] is string && newData()[field].size() <= 500 && (newData()[field] == '' || newData()[field].matches('https://.+')); }
    // Blocks Sri Lankan mobile numbers and email addresses in public text
    function noContact(s) {
      return !s.matches('.*(\\+?94|0)\\s?7[0-9][\\s-]?[0-9]{3}[\\s-]?[0-9]{4}.*')
          && !s.matches('.*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}.*');
    }

    // ---------- Public lists, only admin can change ----------
    match /grades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teachers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /papers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Admin only ----------
    // Teacher phone numbers and emails
    match /teacherPrivate/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- Paid papers ----------
    // Links to paid papers: only students who paid (and admins) can read them
    match /paperLinks/{id} {
      allow read: if isAdmin() || hasAccess();
      allow write: if isAdmin();
    }
    // Who has unlocked papers, and until when: only admin can change
    match /access/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    // Payment details a student sends; the admin checks and approves
    match /payments/{id} {
      allow read: if isAdmin() || isOwner();
      allow create: if verified()
        && exactly(['uid', 'email', 'name', 'amount', 'method', 'ref', 'note', 'made', 'status'])
        && newData().uid == request.auth.uid
        && newData().email == myEmail()
        && newData().status == 'pending'
        && intOk('amount', 1, 999999)
        && textOk('name', 80) && textReq('ref', 60) && textOk('note', 150) && textOk('method', 30) && textOk('made', 40)
        && noContact(newData().note);
      allow update, delete: if isAdmin();
    }

    // ---------- Teachers asking to join (phone number is only for the admin) ----------
    match /teacherApps/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin() || (
        verified()
        && request.auth.uid == uid
        && exactly(['uid', 'email', 'name', 'phone', 'about', 'years', 'bio', 'photo', 'mediums', 'subjects',
                    'district', 'areas', 'classes', 'free', 'made', 'status', 'adminNote'])
        && newData().uid == uid
        && newData().email == myEmail()
        && newData().status == 'pending'
        && newData().adminNote == ''
        && (resource == null || resource.data.status != 'approved')
        && textReq('name', 60) && newData().phone.matches('[+0-9 ()-]{9,15}')
        && textOk('about', 80) && intOk('years', 0, 70) && textOk('bio', 300) && linkOk('photo')
        && textOk('district', 40) && textOk('areas', 120) && textOk('made', 40)
        && listOk('mediums', 3) && listOk('subjects', 80) && listOk('classes', 4) && listOk('free', 21)
        && noContact(newData().name + ' ' + newData().about + ' ' + newData().bio + ' ' + newData().areas)
      );
      allow delete: if isAdmin();
    }

    // ---------- Student requests for a teacher ----------
    match /requests/{id} {
      allow read: if isAdmin() || isOwner();
      allow create: if verified()
        && exactly(['uid', 'student', 'gradeId', 'gradeName', 'subject', 'need', 'place', 'free', 'made', 'status',
                    'teacherId', 'teacherName', 'when', 'preferTeacherId', 'preferTeacherName'])
        && newData().uid == request.auth.uid
        && newData().status == 'new'
        && newData().teacherId == '' && newData().teacherName == '' && newData().when == ''
        && newData().place in ['Online', 'At school']
        && textReq('student', 40) && textReq('need', 400) && textReq('subject', 60)
        && textOk('gradeId', 40) && textOk('gradeName', 40) && textOk('made', 40)
        && textOk('preferTeacherId', 40) && textOk('preferTeacherName', 80)
        && listOk('free', 21)
        && noContact(newData().student + ' ' + newData().need);
      allow update, delete: if isAdmin();
    }

    // ---------- Lessons: made by admin; the student may add stars once, after the lesson ----------
    match /sessions/{id} {
      allow read: if isAdmin() || isOwner();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isOwner()
        && resource.data.status == 'done'
        && resource.data.stars == 0
        && newData().diff(resource.data).affectedKeys().hasOnly(['stars', 'comment'])
        && intOk('stars', 1, 5)
        && textOk('comment', 200) && noContact(newData().comment)
      );
    }

    // ---------- Forum: anyone can post (guests get an invisible anonymous login) ----------
    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && exactly(['uid', 'name', 'gradeId', 'gradeName', 'section', 'subject', 'title', 'text', 'made', 'answerCount'])
        && newData().uid == request.auth.uid
        && newData().answerCount == 0
        && textReq('name', 40) && textReq('title', 160) && textOk('text', 800)
        && textOk('gradeId', 40) && textOk('gradeName', 40) && textOk('section', 20) && textOk('subject', 60) && textOk('made', 40)
        && noContact(newData().name + ' ' + newData().title + ' ' + newData().text);
      // anyone signed in may add 1 to the answer counter; admin may do anything
      allow update: if isAdmin() || (
        signedIn()
        && newData().diff(resource.data).affectedKeys().hasOnly(['answerCount'])
        && newData().answerCount == resource.data.answerCount + 1
      );
      allow delete: if isAdmin();

      match /answers/{answerId} {
        allow read: if true;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(id))
          && exactly(['uid', 'name', 'text', 'made', 'admin'])
          && newData().uid == request.auth.uid
          && newData().admin is bool
          && (newData().admin == false || isAdmin())
          && textReq('name', 40) && textReq('text', 800) && textOk('made', 40)
          && noContact(newData().name + ' ' + newData().text);
        allow delete: if isAdmin();
      }
    }
  }
}
